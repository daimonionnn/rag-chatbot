# Upstream repos — cloned separately, not vendored here:
#   git clone https://github.com/Sheryl-shiyi/RAG
#   git clone https://github.com/Sheryl-shiyi/Nemo-guardrial-deployment nemo-guardrails
RAG/
nemo-guardrails/
ragas-poc/
ragas-provider/

# Internal documents — kept locally, never committed
docs/*
!docs/sk-translation/

# Evaluation artefacts: generated, and derived from the internal docs above
rag-eval/results/

# Belebele slice: someone else's dataset (Meta, CC-BY-SA-4.0). The fetcher and
# our own results are committed; the corpus is not redistributed here.
sk-eval/belebele_*.json

# Local runtime logs
*.log

# Python bytecode
__pycache__/
*.py[cod]

# Python venvs (uv drops its own .gitignore inside each; listed for clarity)
.client06-venv/
.ls06-venv/
.llamastack-venv/

# Local secrets (API keys) — see SETUP.md
.env.local
