# Llama Stack 0.6.0 server for the RAG chatbot, backed by host Ollama.
#
# WHY 0.6.0 (and not the compose's 0.2.9): the repo's frontend pins
# llama-stack-client==0.6.0 and uses the OpenAI-compatible surface
# (vector_stores / responses / conversations / chat.completions) that only
# exists from 0.6.0 onward. The compose image tag (0.2.9) predates those APIs,
# so the UI got HTTP 404 against a real 0.2.9 server. This image aligns the
# server to the UI's version. It is tagged as the compose's
# `llamastack/distribution-ollama:0.2.9` so podman-compose.yml stays unchanged.
#
# Build:
#   podman build -f llamastack-local-image/Containerfile-0.6.0 \
#     -t docker.io/llamastack/distribution-ollama:0.2.9 llamastack-local-image
FROM python:3.12-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl git gcc g++ && rm -rf /var/lib/apt/lists/*

ENV UV_SYSTEM_PYTHON=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1
RUN pip install uv

# Provider dependencies for the trimmed config (from `llama stack list-deps`).
RUN uv pip install --no-cache \
        pandas pillow 'mcp>=1.23.0' aiosqlite matplotlib psycopg2-binary 'h11>=0.16.0' \
        sentencepiece 'nltk>=3.9.3' scipy pymongo aiohttp chardet asyncpg numpy ollama \
        faiss-cpu tokenizers 'sqlalchemy[asyncio]' safetensors scikit-learn 'pypdf>=6.7.2' \
        requests tqdm transformers redis 'fonttools>=4.60.2' einops fastapi fire httpx \
        uvicorn opentelemetry-sdk opentelemetry-exporter-otlp-proto-http
RUN uv pip install --no-cache torch torchvision 'torchao>=0.12.0' \
        --extra-index-url https://download.pytorch.org/whl/cpu
RUN uv pip install --no-cache sentence-transformers --no-deps
# Pin the whole llama-stack trio to 0.6.0. llama-stack declares llama-stack-api
# UNPINNED, so an unpinned install pulls a newer api package that is ABI-
# incompatible with 0.6.0 (ImportError on `agents`). Pin all three explicitly.
RUN uv pip install --no-cache \
        'llama-stack==0.6.0' 'llama-stack-api==0.6.0' 'llama-stack-client==0.6.0'

# RAGAS as an out-of-tree eval provider (TrustyAI). Provider 0.7.0 is the release
# that targets llama-stack 0.6.x, so it matches this image exactly. The
# llama-stack trio is re-pinned in the same command so the resolver cannot drift
# it while satisfying ragas' own bounds. greenlet is pinned because the provider
# documents inline/files/localfs failing with "greenlet not found" without it.
RUN uv pip install --no-cache \
        'llama-stack-provider-ragas==0.7.0' \
        'greenlet==3.2.4' \
        'langchain-community>=0.3,<0.4' \
        'llama-stack==0.6.0' 'llama-stack-api==0.6.0' 'llama-stack-client==0.6.0'

# Backs the `remote::anthropic` inference provider, used only as a RAGAS judge
# (EVALUATION-LIMITS.md §4.5 — a judge that is not one of the three contestants).
# llama-stack ships the adapter but not its dependency, so importing the provider
# fails with ModuleNotFoundError without this. The adapter is an OpenAIMixin
# against api.anthropic.com/v1 and discovers models from the live Models API, so
# no model allowlist has to be patched for newer Claude releases.
RUN uv pip install --no-cache anthropic
RUN pip uninstall -y uv

# Fix non-latin-1 (e.g. Slovak č/š/ž) filenames silently failing to ingest:
# llama-stack puts the raw filename in a Content-Disposition header, which HTTP
# forbids for non-latin-1. See the script's docstring for the full story.
COPY patch-content-disposition.py /tmp/patch-content-disposition.py
RUN python /tmp/patch-content-disposition.py && rm /tmp/patch-content-disposition.py

# Fix the RAGAS provider's sync->async embedding bridge, which otherwise fails
# every embeddings-based metric with "This event loop is already running".
COPY patch-ragas-embeddings-loop.py /tmp/patch-ragas-embeddings-loop.py
RUN python /tmp/patch-ragas-embeddings-loop.py && rm /tmp/patch-ragas-embeddings-loop.py

# Recover factual_correctness: ragas keys ModeMetric scores as "<name>(mode=…)"
# but the provider looks them up by the bare name, killing the job with KeyError.
COPY patch-ragas-mode-metrics.py /tmp/patch-ragas-mode-metrics.py
RUN python /tmp/patch-ragas-mode-metrics.py && rm /tmp/patch-ragas-mode-metrics.py

# The provider asks the judge for text through the legacy /v1/completions API,
# which Anthropic does not serve (404 on every call) — see the script's docstring
# for why the fallback is scoped to that provider only.
COPY patch-ragas-chat-completions.py /tmp/patch-ragas-chat-completions.py
RUN python /tmp/patch-ragas-chat-completions.py && rm /tmp/patch-ragas-chat-completions.py

COPY config-0.6.0.yaml /app/config.yaml

# The frontend client and this server are both 0.6.0, but keep the check off so
# a slightly different client patch version can still connect.
ENV LLAMA_STACK_DISABLE_VERSION_CHECK=1
ENTRYPOINT ["llama", "stack", "run", "/app/config.yaml"]
